# Maintainer: pantr1x
# Flux (Rust) – hotový program z GitHubu, bez pridania repozitára:
#   curl -fsSLO https://raw.githubusercontent.com/pantr1x/Flux/ci-native-linux/PKGBUILD && makepkg -si
# (Jednoduchšie: pridaj repozitár [flux] do pacman.conf, pozri README.)
pkgname=flux-editor
pkgver=0.9.55
pkgrel=1
pkgdesc='Flux – a small, fast code editor with one-click Run and Live Server (Rust)'
arch=('x86_64')
url='https://pantr1x.github.io/Flux/'
license=('MIT')
depends=('libxkbcommon' 'libglvnd' 'libx11' 'libxcb' 'mesa')
optdepends=('webkit2gtk-4.1: Live Server page inside Flux')
provides=('flux')
options=('!strip')
_raw='https://raw.githubusercontent.com/pantr1x/Flux/ci-native-linux'
source=("flux-native::$_raw/Flux-Native" "flux.png::https://pantr1x.github.io/Flux/icon.png")
sha256sums=('SKIP' 'SKIP')

pkgver() {
  curl -fsSL "$_raw/native.json" | tr -d '\n ' | grep -o '"version":"[^"]*"' | head -n1 | cut -d'"' -f4
}

package() {
  install -Dm755 flux-native "$pkgdir/usr/bin/flux"
  install -Dm644 flux.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/flux.png"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/flux.desktop" <<DESK
[Desktop Entry]
Type=Application
Name=Flux
GenericName=Code Editor
Comment=A small, good-looking code editor
Exec=flux %F
Icon=flux
Terminal=false
StartupWMClass=flux
Categories=Development;TextEditor;IDE;
MimeType=text/plain;text/x-python;text/html;text/css;application/javascript;application/json;
DESK
}
