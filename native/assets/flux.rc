// Ikona a údaje programu pre Windows (Správca úloh, panel úloh, vlastnosti súboru).
1 ICON "flux.ico"

1 VERSIONINFO
FILEVERSION 0,4,0,0
PRODUCTVERSION 0,4,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Flux"
      VALUE "FileDescription", "Flux"
      VALUE "ProductName", "Flux"
      VALUE "InternalName", "flux-native"
      VALUE "OriginalFilename", "Flux-Native.exe"
      VALUE "FileVersion", "0.4.0"
      VALUE "ProductVersion", "0.4.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
